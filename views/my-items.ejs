<%- include('partials/header', { pageTitle: 'My listings', market: true, current: 'my-items' }) %>
<section class="app-page-content">
  <header class="app-page-head">
    <div><p class="section-kicker">Seller workspace</p><h1>My listings</h1><p class="app-listing-count"><%= items.length %> <%= items.length === 1 ? 'listing' : 'listings' %></p></div>
    <a href="/sell" class="app-btn app-btn-primary">+ New listing</a>
  </header>
  <% if (items.length === 0) { %>
    <p class="empty-state">You haven't listed anything yet. <a href="/sell">List your first item</a>.</p>
  <% } else { %>
    <div class="app-listing-list">
      <% items.forEach(function(item){ %>
        <article class="app-listing-row">
          <a class="app-listing-thumb artwork art-<%= item.id % 4 %><%= item.image ? ' has-photo' : '' %>" href="/item/<%= item.id %>">
            <% if (item.image) { %><img class="listing-photo" src="<%= item.image %>" alt="" loading="lazy" /><% } else { %><span class="artwork-mark" aria-hidden="true"></span><% } %>
            <span class="artwork-category"><%= item.category %></span>
          </a>
          <div class="app-listing-main">
            <div class="app-listing-info">
              <div class="app-listing-top">
                <h2><a href="/item/<%= item.id %>"><%= item.title %></a></h2>
                <span class="app-status app-status-<%= item.status %>"><%= item.status %></span>
              </div>
              <p class="app-listing-meta"><span class="app-listing-price"><%= currency %><%= Number(item.price).toLocaleString() %></span><span><%= item.category %></span><span>Location: <%= item.location || 'N/A' %></span></p>
              <% if (item.status === 'rejected') { %>
                <div class="app-reason-box"><strong>Rejected:</strong> <%= item.rejectReason || 'No reason provided.' %></div>
              <% } %>
              <div class="app-listing-actions">
                <% if (item.status === 'approved') { %>
                  <form method="post" action="/item/<%= item.id %>/sold"><button class="app-btn app-btn-ghost app-btn-sm" type="submit">Mark as sold</button></form>
                <% } else if (item.status === 'sold') { %>
                  <form method="post" action="/item/<%= item.id %>/relist"><button class="app-btn app-btn-ghost app-btn-sm" type="submit">Relist</button></form>
                <% } %>
                <form method="post" action="/item/<%= item.id %>/delete" data-confirm="Delete this listing permanently?"><button class="app-btn app-btn-ghost app-btn-danger app-btn-sm" type="submit">Delete</button></form>
              </div>
            </div>
            <details class="app-listing-history">
              <summary>Status history (<%= (item.history||[]).length %>)</summary>
              <%- include('partials/timeline', { item: item }) %>
            </details>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>
<%- include('partials/footer', { pageTitle: 'My listings', market: true, current: 'my-items' }) %>
