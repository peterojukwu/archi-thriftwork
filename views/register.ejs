<%- include('partials/header', { pageTitle: 'Register' }) %>
<section class="wrap auth">
  <div class="auth-card">
    <h1>Create your account</h1>
    <p class="muted">Register to list items for sale. Browsing is open to everyone.</p>
    <form method="post" action="/register">
      <div class="field"><label>Full name</label><input name="name" value="<%= form.name || '' %>" required /></div>
      <div class="field"><label>Email</label><input type="email" name="email" value="<%= form.email || '' %>" required /></div>
      <div class="field"><label>Password</label><input type="password" name="password" minlength="6" required /></div>
      <div class="field"><label>Confirm password</label><input type="password" name="confirm" minlength="6" required /></div>
      <button class="btn btn-primary full">Create account</button>
    </form>
    <p class="muted center small">Already have an account? <a href="/login">Log in</a></p>
  </div>
</section>
<%- include('partials/footer') %>
