{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "public" }
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/item/(\\d+)/?$", "dest": "/item/$1.html" },
    { "src": "^/(sell|my-items|admin)/?$", "dest": "/login.html" },
    { "src": "^/(login|register)/?$", "dest": "/$1.html" }
  ]
}